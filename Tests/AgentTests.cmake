cmake_minimum_required(VERSION 3.24)
file(MAKE_DIRECTORY "${TEST_DIRECTORY}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef unique)
set(scene "${TEST_DIRECTORY}/${unique}.bwscene")
execute_process(COMMAND "${AGENT_EXECUTABLE}" create "${scene}" RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Agent create failed: ${output}")
endif()
set(batch "${TEST_DIRECTORY}/${unique}.json")
file(WRITE "${batch}" "[{\"Operation\":\"Create\",\"Name\":\"First\"},{\"Operation\":\"Rename\",\"ID\":1,\"Name\":\"Renamed\"}]")
execute_process(COMMAND "${AGENT_EXECUTABLE}" apply "${scene}" "${batch}" RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Agent apply failed: ${output}")
endif()
string(JSON entityName GET "${output}" Scene Entities 0 Name)
if(NOT entityName STREQUAL "Renamed")
  message(FATAL_ERROR "Agent batch did not update the real scene")
endif()
file(SHA256 "${scene}" before)
file(WRITE "${batch}" "[{\"Operation\":\"SetRendererSettings\",\"Settings\":{\"Exposure\":0.6,\"Shadows\":false}}]")
execute_process(COMMAND "${AGENT_EXECUTABLE}" apply "${scene}" "${batch}" RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Agent renderer settings failed")
endif()
string(JSON exposure GET "${output}" Scene Renderer Exposure)
string(JSON shadows GET "${output}" Scene Renderer Shadows)
if(NOT exposure LESS 0.61 OR NOT exposure GREATER 0.59 OR shadows)
  message(FATAL_ERROR "Agent renderer settings were not persisted")
endif()
file(WRITE "${batch}" "[{\"Operation\":\"SetSnowSettings\",\"Settings\":{\"Enabled\":true,\"Resolution\":256,\"BaseDepth\":0.6,\"RenderGround\":true}},{\"Operation\":\"SetRendererSettings\",\"Settings\":{\"SnowCoverage\":0.9,\"SnowfallIntensity\":0.5}}]")
execute_process(COMMAND "${AGENT_EXECUTABLE}" apply "${scene}" "${batch}" RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Agent snow settings failed: ${output}")
endif()
string(JSON snowEnabled GET "${output}" Scene Snow Enabled)
string(JSON snowRes GET "${output}" Scene Snow Resolution)
string(JSON snowGround GET "${output}" Scene Snow RenderGround)
string(JSON snowCoverage GET "${output}" Scene Renderer SnowCoverage)
if(NOT snowEnabled OR NOT snowRes EQUAL 256 OR NOT snowGround OR NOT snowCoverage GREATER 0.85)
  message(FATAL_ERROR "Agent snow settings were not persisted")
endif()
file(WRITE "${batch}" "[{\"Operation\":\"SetModel\",\"ID\":1,\"Asset\":\"Models/Cabin.glb\"}]")
execute_process(COMMAND "${AGENT_EXECUTABLE}" apply "${scene}" "${batch}" RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Agent model command failed")
endif()
string(JSON modelAsset GET "${output}" Scene Entities 0 Model Asset)
if(NOT modelAsset STREQUAL "Models/Cabin.glb")
  message(FATAL_ERROR "Agent model reference was not persisted")
endif()
file(WRITE "${batch}" "[{\"Operation\":\"SetPhysics\",\"ID\":1,\"Physics\":{\"Enabled\":true,\"Shape\":\"Capsule\",\"Motion\":\"Dynamic\",\"Radius\":0.4,\"HalfHeight\":0.8,\"Mass\":60.0}}]")
execute_process(COMMAND "${AGENT_EXECUTABLE}" apply "${scene}" "${batch}" RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Agent SetPhysics failed: ${output}")
endif()
string(JSON physShape GET "${output}" Scene Entities 0 Physics Shape)
if(NOT physShape STREQUAL "Capsule")
  message(FATAL_ERROR "Agent Physics component was not persisted")
endif()
execute_process(COMMAND "${AGENT_EXECUTABLE}" inspect-model "${MODEL_FIXTURE_DIRECTORY}/Materials.glb" RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Agent model validation failed: ${output}")
endif()
string(JSON primitiveCount GET "${output}" Primitives)
if(NOT primitiveCount EQUAL 6)
  message(FATAL_ERROR "Agent model inspection returned incorrect geometry counts")
endif()
execute_process(COMMAND "${AGENT_EXECUTABLE}" inspect-model "${MODEL_FIXTURE_DIRECTORY}/BadImage.gltf" RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE output)
if(result EQUAL 0)
  message(FATAL_ERROR "Agent accepted a corrupt model image")
endif()
string(JSON modelSuccess GET "${output}" Success)
if(modelSuccess)
  message(FATAL_ERROR "Agent failure response claims success")
endif()
file(SHA256 "${scene}" before)
file(WRITE "${batch}" "[{\"Operation\":\"Rename\",\"ID\":1,\"Name\":\"Must Roll Back\"},{\"Operation\":\"Destroy\",\"ID\":9999}]")
execute_process(COMMAND "${AGENT_EXECUTABLE}" apply "${scene}" "${batch}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
  message(FATAL_ERROR "Invalid agent batch returned success")
endif()
file(SHA256 "${scene}" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Failed agent batch modified the saved scene")
endif()
execute_process(COMMAND "${AGENT_EXECUTABLE}" create "${scene}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
  message(FATAL_ERROR "Agent create overwrote an existing scene")
endif()
file(SHA256 "${scene}" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Rejected create modified the saved scene")
endif()
execute_process(COMMAND "${AGENT_EXECUTABLE}" validate "${scene}" RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Saved agent scene does not validate")
endif()

set(snowTracks "${TEST_DIRECTORY}/Tracks.bwsn")
file(REMOVE "${snowTracks}")
execute_process(COMMAND "${AGENT_EXECUTABLE}" stamp-snow "${snowTracks}" 0 0 2.0 0.35 64 64.0 0.5 RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Agent stamp-snow failed: ${output}")
endif()
string(JSON snowTrackCount GET "${output}" ActiveTrackCount)
string(JSON snowStamped GET "${output}" Stamped)
if(snowTrackCount LESS 1 OR NOT snowStamped)
  message(FATAL_ERROR "Agent stamp-snow reported zero active track cells or false Stamped")
endif()
set(missingSnow "${TEST_DIRECTORY}/MissingTracks.bwsn")
file(REMOVE "${missingSnow}")
execute_process(COMMAND "${AGENT_EXECUTABLE}" stamp-snow "${missingSnow}" 0 0 2.0 0.35 RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0 OR EXISTS "${missingSnow}")
  message(FATAL_ERROR "Agent 7-arg stamp-snow silently created a missing .bwsn file")
endif()
execute_process(COMMAND "${AGENT_EXECUTABLE}" stamp-snow "${missingSnow}" 0 0 2.0 0.35 2048 64.0 0.5 RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0 OR EXISTS "${missingSnow}")
  message(FATAL_ERROR "Agent stamp-snow accepted out-of-range resolution 2048")
endif()
execute_process(COMMAND "${AGENT_EXECUTABLE}" inspect-snow "${snowTracks}" RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Agent inspect-snow failed: ${output}")
endif()
string(JSON snowRes GET "${output}" Resolution)
if(NOT snowRes EQUAL 64)
  message(FATAL_ERROR "Agent inspect-snow reported unexpected resolution: ${snowRes}")
endif()
execute_process(COMMAND "${AGENT_EXECUTABLE}" step-snow "${snowTracks}" 2.0 1.2 4.0 -1.5 -8.0 RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Agent step-snow failed: ${output}")
endif()
file(SHA256 "${snowTracks}" snowBefore)
execute_process(COMMAND "${AGENT_EXECUTABLE}" stamp-snow "${snowTracks}" 0 0 -1.5 0.3 RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
  message(FATAL_ERROR "Agent stamp-snow accepted invalid negative radius")
endif()
file(SHA256 "${snowTracks}" snowAfter)
if(NOT snowBefore STREQUAL snowAfter)
  message(FATAL_ERROR "Rejected stamp-snow modified existing .bwsn file")
endif()
set(corruptSnow "${TEST_DIRECTORY}/Corrupt.bwsn")
file(WRITE "${corruptSnow}" "BWSN_CORRUPT")
execute_process(COMMAND "${AGENT_EXECUTABLE}" inspect-snow "${corruptSnow}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
  message(FATAL_ERROR "Agent inspect-snow accepted corrupt .bwsn binary")
endif()
message(STATUS "BELLWETHER_AGENT create/apply/rename/models/snow/renderer/rollback/overwrite protection/validate passed")
