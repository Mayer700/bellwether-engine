cmake_minimum_required(VERSION 3.24)
file(MAKE_DIRECTORY "${TEST_DIRECTORY}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef unique)
set(scene "${TEST_DIRECTORY}/${unique}.bwscene")
execute_process(COMMAND "${AGENT_EXECUTABLE}" create "${scene}" RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Agent create failed: ${output}")
endif()
set(batch "${TEST_DIRECTORY}/${unique}.json")
file(WRITE "${batch}" "[{\"Operation\":\"Create\",\"Name\":\"First\"},{\"Operation\":\"Rename\",\"ID\":1,\"Name\":\"Renamed\"}]")
execute_process(COMMAND "${AGENT_EXECUTABLE}" apply "${scene}" "${batch}" RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Agent apply failed: ${output}")
endif()
string(JSON entityName GET "${output}" Scene Entities 0 Name)
if(NOT entityName STREQUAL "Renamed")
  message(FATAL_ERROR "Agent batch did not update the real scene")
endif()
file(SHA256 "${scene}" before)
file(WRITE "${batch}" "[{\"Operation\":\"Rename\",\"ID\":1,\"Name\":\"Must Roll Back\"},{\"Operation\":\"Destroy\",\"ID\":9999}]")
execute_process(COMMAND "${AGENT_EXECUTABLE}" apply "${scene}" "${batch}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
  message(FATAL_ERROR "Invalid agent batch returned success")
endif()
file(SHA256 "${scene}" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Failed agent batch modified the saved scene")
endif()
execute_process(COMMAND "${AGENT_EXECUTABLE}" create "${scene}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
  message(FATAL_ERROR "Agent create overwrote an existing scene")
endif()
file(SHA256 "${scene}" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Rejected create modified the saved scene")
endif()
execute_process(COMMAND "${AGENT_EXECUTABLE}" validate "${scene}" RESULT_VARIABLE result OUTPUT_VARIABLE output)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Saved agent scene does not validate")
endif()
message(STATUS "BELLWETHER_AGENT create/apply/rename/rollback/overwrite protection/validate passed")
